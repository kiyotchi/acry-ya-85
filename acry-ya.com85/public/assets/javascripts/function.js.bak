	    if($('.p-overview--semiorder').length) {
	      var thisWidth = $(window).width();
	      window.addEventListener("resize", function () {
	        if (thisWidth != $(window).width()) {
	          semiorderDom();
	          thisWidth = $(window).width();
	        }
	      });
	    };
	
