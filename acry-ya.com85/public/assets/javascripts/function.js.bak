	    /*-----------------------------------------*/
	
	    $(window).on('load', function() {
	      if($('.p-overview--semiorder').length) {
	        semiorderDom();
	      };
	      if(!$('body').hasClass('is-tb')) {
	        mainVisualDom();
	        fixedDom();
	      }
	      haisouPrice();
