	      } else
	      if (windowW >= breakPoint[0] + 1) {
	        // alert('aa')
	        if($('.promotion__detail').length) {
	          $(mainVisual).insertBefore('.promotion__detail');
	        } else {
	          $(mainVisual).insertBefore('.overview__detail');
	        }
