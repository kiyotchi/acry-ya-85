// Cookie削除処理
function cookieClear() {
    document.cookie = "souhu_info=;";
    document.cookie = "width=;";
    document.cookie = "height=;";
    document.cookie = "suu=;";
}

function reflectTotalPrice() {
    let total = $('#total_value').val();
    total = Number(total.replace(/,/g, ''));
    total = String(total).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1,');
    $('#total').html(total);
}

function reflectUnitPrice() {
    let unitPrice = $('#price').val();
    unitPrice = Number(unitPrice.replace(/,/g, ''));
    unitPrice = String(unitPrice).replace(/(\d)(?=(\d{3})+(?!\d))/g, '$1,');
    $('#unit_price').text(unitPrice);
}

function reflectFixedPrice() {
    let fixedPrice = $('#price').val();
    $('#fixed_price').text(fixedPrice);
    // $('#base_price').val(Number(fixedPrice.replace(/,/g, '')));
}

function reflectDeliveryPrivatePrice() {
@if( !empty($product->productSetting->delivery_private_price_html_tag_id) )
    let privatePrice = $('[name={{ $product->productSetting->delivery_private_price_html_tag_id }}]').val();
    $('#private_price').text(privatePrice);
@endif
}

function reflectDeliveryFarawayPrice() {
@if( !empty($product->productSetting->delivery_faraway_price_html_tag_id) )
    let farawayPrice = $('[name={{ $product->productSetting->delivery_faraway_price_html_tag_id }}]').val();
    $('#faraway_price').text(farawayPrice);
@endif
}

// 規格選択時のページ遷移処理
function redirect() {
    let redirectUrlArray = [];
@if( !empty($product->productSetting->is_color_valid) )
    if ($('[name={{ $product->productSetting->color_html_tag_id }}]').length) {
        let color = $('[name={{ $product->productSetting->color_html_tag_id }}] option:selected').data('id');
        if (color != '') {
            redirectUrlArray.push('color=' + color);
        }
    }
@endif
@if( !empty($product->productSetting->is_size_valid) )
    @if($product->productSetting->specify_size === \App\ValueObject\SizeType::SIZE_OF_NUMERIC )
    if ($('[name={{ $product->productSetting->specification_size_numerical_html_tag_id }}]').length) {
        let size = $('[name={{ $product->productSetting->specification_size_numerical_html_tag_id }}] option:selected').data('id');
        if (size != '') {
            redirectUrlArray.push('size=' + size);
        }
    }
    @endif
    @if($product->productSetting->specify_size === \App\ValueObject\SizeType::SIZE_OF_STRING)
    if ($('[name={{ $product->productSetting->specification_size_string_html_tag_id }}]').length) {
        let size = $('[name={{ $product->productSetting->specification_size_string_html_tag_id }}] option:selected').data('id');
        if (size != '') {
            redirectUrlArray.push('size=' + size);
        }
    }
    @endif
@endif
@if( !empty($product->productSetting->is_plate_thickness_valid) )
    if ($('[name={{ $product->productSetting->plate_thickness_html_tag_id }}]').length) {
        let thickness = $('[name={{ $product->productSetting->plate_thickness_html_tag_id }}] option:selected').data('id');
        if (thickness != '') {
            redirectUrlArray.push('thickness=' + thickness);
        }
    }
@endif
@if( !empty($product->productSetting->is_product_option_valid) )
    if ($('[name={{ $product->productOption->html_tag_name }}]').length) {
        let option = $('[name={{ $product->productOption->html_tag_name }}] option:selected').data('id');
        if (option != '') {
            redirectUrlArray.push('option=' + option);
        }
    }
@endif
    let redirectUrl = '?' + redirectUrlArray.join('&');

    window.location.href = redirectUrl;
}