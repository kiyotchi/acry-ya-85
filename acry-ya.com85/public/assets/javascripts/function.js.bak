	    var semiorderDom = function() {
	      if (windowW <= breakPoint[0]) {
	        $(semiorder).insertAfter('.overview__detail');
	      } else
	      if (windowW >= breakPoint[0] + 1) {
	        $(semiorder).insertAfter('.overview__tag');
	      }
