# ---------------------------------------------------------------------------
# Docker Compose 用の環境変数
#   cp env.example .env してから必要に応じて編集する
#   .env は Git 管理しない
# ---------------------------------------------------------------------------

# ホスト側ポート
FRONT58_PORT=8002
ADMIN58_PORT=8003
FRONT85_PORT=8000
ADMIN85_PORT=8001

# 85系のPHPバージョン（フェーズ進行に合わせて変更）
#   Phase 0〜1: 7.2.34 / composer:2.2
#   Phase 2〜3: 7.4.33 / composer:2
#   Phase 4:    8.1.31 / composer:2
#   Phase 5:    8.2.29 / composer:2
#   Phase 6〜7: 8.3.26 / composer:2
#   Phase 8〜9: 8.5.0  / composer:2
PHP85_VERSION=7.2.34
PHP85_COMPOSER_IMAGE=composer:2.2

# MySQL
#   ホストからは localhost:3306 / root:root で接続する
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
# 以下は予備ユーザー（acryya58 / acryya85）用。アプリは root で接続する
DB_PASSWORD_58=acryya58
DB_PASSWORD_85=acryya85

# Mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# phpMyAdmin（任意）
PMA_PORT=8080
